{
  "extraKnownMarketplaces": {
    "alexgreensh-token-optimizer": {
      "source": {
        "source": "github",
        "repo": "alexgreensh/token-optimizer"
      }
    }
  },
  "enabledPlugins": {
    "token-optimizer@alexgreensh-token-optimizer": true
  },
  "permissions": {
    "deny": [
      "Read(//home/markk/ares/cbe-generation-system/data/ares_index/**)",
      "Read(//home/markk/ares/cbe-generation-system/venv/**)",
      "Read(//home/markk/ares/cbe-generation-system/.env)",
      "Read(//home/markk/ares/cbe-generation-system/data/outputs/**/*.docx)",
      "Read(//home/markk/ares/cbe-generation-system/data/outputs/**/*.pdf)",
      "Read(//home/markk/ares/cbe-generation-system/data/outputs/docx/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "cat >/dev/null || true; command -v code-review-graph >/dev/null 2>&1 || exit 0; git rev-parse --git-dir >/dev/null 2>&1 && code-review-graph update --skip-flows --repo \"$(git rev-parse --show-toplevel 2>/dev/null)\" || true",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "cat >/dev/null || true; command -v code-review-graph >/dev/null 2>&1 || exit 0; git rev-parse --git-dir >/dev/null 2>&1 && code-review-graph status --repo \"$(git rev-parse --show-toplevel 2>/dev/null)\" || echo 'Not a git repo, skipping'",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
